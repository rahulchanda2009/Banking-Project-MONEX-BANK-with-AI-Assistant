# ---- Secrets (never commit) ----
.env
.env.*
!.env.example
*.pem
*.key
certs/

# ---- Python ----
venv/
venv-*/
__pycache__/
*.pyc

# ---- Runtime files and logs ----
*.log
.ai.pid
.pf.pid
nohup.out

# ---- Backups ----
*.bak
*.bak[0-9]*

# ---- Node / React ----
node_modules/
frontend/build/

# ---- Java ----
backend/target/
*.class

# ---- OS / editor ----
.DS_Store
.vscode/
.idea/


# ---- Kubernetes secrets ----
k8s/*secret*.yaml
!k8s/*secret*.example.yaml

# ---- Backups with other naming ----
*_bak*
*_bkp*

# ---- Videos / large media ----
*.mov
*.mp4
